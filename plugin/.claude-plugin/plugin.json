{
  "name": "better-tg-cli",
  "displayName": "Better-TG-CLI",
  "description": "Unofficial Telegram client for your own account: a skill for the telegram CLI plus a local MCP server to read, search and send messages. The agent asks you before every send.",
  "author": {
    "name": "Sergei Polin",
    "url": "https://github.com/TheVilfer"
  },
  "homepage": "https://github.com/TheVilfer/better-tg-cli",
  "repository": "https://github.com/TheVilfer/better-tg-cli",
  "license": "MIT",
  "keywords": [
    "telegram",
    "mtproto",
    "cli",
    "mcp"
  ],
  "mcpServers": {
    "telegram": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/telegram.mjs",
        "mcp"
      ]
    }
  },
  "version": "0.39.3"
}
