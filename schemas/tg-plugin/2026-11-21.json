{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://better-tg-cli.com/schemas/tg-plugin/2026-11-21.json",
  "title": "Better-TG-CLI plugin manifest (tg-plugin.json), spec version 2026-11-21",
  "description": "See https://github.com/TheVilfer/better-tg-cli/blob/main/docs/plugins.md. Rules a schema cannot express (Windows-reserved names, case-insensitive uniqueness, references between fields, the SKILL.md frontmatter) are checked by `telegram plugin validate`.",
  "type": "object",
  "required": ["$schema", "name", "version", "description", "files"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "description": "The spec version this manifest is written for, as the URL of its schema.",
      "type": "string",
      "pattern": "^https://better-tg-cli\\.com/schemas/tg-plugin/[0-9]{4}-[0-9]{2}-[0-9]{2}\\.json$"
    },
    "name": {
      "description": "Agent Skills name: lowercase letters, digits and single hyphens. Equals the name in the SKILL.md frontmatter.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "description": "SemVer 2.0.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "description": { "$ref": "#/$defs/line", "maxLength": 1024 },
    "author": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/line", "maxLength": 100 },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "email": { "type": "string", "maxLength": 254, "pattern": "^[^@\\s]+@[^@\\s]+$" }
      }
    },
    "license": { "$ref": "#/$defs/line", "maxLength": 100 },
    "homepage": { "$ref": "#/$defs/httpsUrl" },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "better-tg-cli": {
          "description": "A node-semver range of CLI versions. A prerelease CLI matches only a range that names a prerelease of the same version.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "main": {
      "description": "The plugin code (runs from spec P2 on): one ES2023 module without imports. Must be listed in files.",
      "$ref": "#/$defs/path"
    },
    "files": {
      "description": "Every file of the plugin. tg-plugin.json and SKILL.md are required. Nothing else is installed or read.",
      "type": "array",
      "minItems": 2,
      "maxItems": 200,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "identity:read", "messages:read-own", "chats:read", "messages:read", "messages:read-target",
          "storage:read", "storage:write", "network", "settings:read", "actions"
        ]
      }
    },
    "network": {
      "description": "Exact HTTPS origins the plugin may call.",
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/origin" }
    },
    "secrets": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["name", "description", "inject"],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "#/$defs/key" },
          "description": { "$ref": "#/$defs/line", "maxLength": 200 },
          "inject": {
            "type": "object",
            "required": ["origin", "header", "format"],
            "additionalProperties": false,
            "properties": {
              "origin": { "$ref": "#/$defs/origin" },
              "header": {
                "description": "The request header the host sets to the formatted value. Not one the host sets itself (Host, Cookie, Content-Length, Transfer-Encoding, Connection, Proxy-*, …); Authorization is allowed.",
                "type": "string", "maxLength": 100, "pattern": "^[A-Za-z0-9-]+$"
              },
              "format": {
                "description": "The header value: printable ASCII with {value} where the secret goes, e.g. \"Bearer {value}\".",
                "type": "string", "maxLength": 200, "pattern": "^[\\x20-\\x7e]*\\{value\\}[\\x20-\\x7e]*$"
              },
              "paths": {
                "type": "array",
                "maxItems": 20,
                "items": { "type": "string", "maxLength": 200, "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$" }
              }
            }
          }
        }
      }
    },
    "settings": {
      "description": "Non-secret settings the user may change (`plugin settings set`): each one a small JSON Schema (type, enum, minimum, maximum, minLength, maxLength, default).",
      "type": "object",
      "maxProperties": 50,
      "propertyNames": { "$ref": "#/$defs/key" },
      "additionalProperties": {
        "type": "object",
        "required": ["type", "description"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["string", "integer", "number", "boolean"] },
          "description": { "$ref": "#/$defs/line", "maxLength": 200 },
          "default": { "description": "Must itself be a valid value of this setting.", "type": ["string", "integer", "number", "boolean"] },
          "enum": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "type": ["string", "integer", "number"] } },
          "minimum": { "type": "number" },
          "maximum": { "type": "number" },
          "minLength": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "maxLength": { "type": "integer", "minimum": 0, "maximum": 10000 }
        }
      }
    },
    "resources": {
      "description": "Logical name → file in files, optionally #heading-slug for one section of a Markdown file.",
      "type": "object",
      "maxProperties": 50,
      "propertyNames": { "$ref": "#/$defs/key" },
      "additionalProperties": { "$ref": "#/$defs/resourceRef" }
    },
    "storage": {
      "type": "object",
      "required": ["keys"],
      "additionalProperties": false,
      "properties": {
        "keys": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "$ref": "#/$defs/key" } },
        "quotaBytes": { "type": "integer", "minimum": 1, "maximum": 4194304 }
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["name", "description", "effects", "input", "output"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "description": { "$ref": "#/$defs/line", "maxLength": 300 },
          "effects": { "type": "array", "uniqueItems": true, "items": { "enum": ["storage", "network", "actions"] } },
          "input": { "description": "Self-contained JSON Schema 2020-12 (own $defs, no external $ref, no other $schema).", "type": "object" },
          "output": { "description": "Self-contained JSON Schema 2020-12.", "type": "object" }
        }
      }
    },
    "triggers": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "when", "resource"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/key" },
          "when": { "$ref": "#/$defs/line", "maxLength": 200 },
          "resource": { "$ref": "#/$defs/key" }
        }
      }
    },
    "onboarding": {
      "type": "object",
      "required": ["resource", "doneWhen"],
      "additionalProperties": false,
      "properties": {
        "resource": { "$ref": "#/$defs/key" },
        "doneWhen": {
          "type": "object",
          "required": ["storage"],
          "additionalProperties": false,
          "properties": { "storage": { "$ref": "#/$defs/key" } }
        }
      }
    }
  },
  "$defs": {
    "line": {
      "description": "One line of text: no control characters.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "key": {
      "description": "A logical name (resource, storage key, trigger, setting, secret).",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "path": {
      "description": "Relative, '/'-separated, canonical (no '.', '..' or empty segments), only [A-Za-z0-9._-] in a segment.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!\\.{1,2}(/|$))(?!.*/\\.{1,2}(/|$))[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
    },
    "resourceRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 265,
      "pattern": "^(?!\\.{1,2}(/|#|$))(?!.*/\\.{1,2}(/|#|$))[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*(#[a-z0-9]+(-[a-z0-9]+)*)?$"
    },
    "origin": {
      "description": "An exact https origin by host name (no path, no user info, no trailing dot, no IP address, no :443).",
      "type": "string",
      "maxLength": 200,
      "pattern": "^https://[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*(:[0-9]{1,5})?$"
    },
    "httpsUrl": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^https://[^\\s]+$"
    }
  }
}
