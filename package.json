{
  "name": "better-tg-cli",
  "version": "0.41.0",
  "description": "Telegram CLI and MCP server for AI agents (Claude Code, Codex, Cursor): read, search, send and press bot buttons on your own account, and approve every send.",
  "keywords": [
    "agent-skills",
    "ai-agents",
    "claude",
    "claude-code",
    "cli",
    "codex",
    "cursor",
    "llm",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "mtproto",
    "telegram",
    "telegram-bot",
    "telegram-cli",
    "telegram-client",
    "telegram-mcp",
    "terminal",
    "userbot"
  ],
  "homepage": "https://github.com/TheVilfer/better-tg-cli#readme",
  "bugs": {
    "url": "https://github.com/TheVilfer/better-tg-cli/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Sergei Polin",
    "url": "https://github.com/TheVilfer"
  },
  "contributors": [
    {
      "name": "Derek Rein",
      "url": "https://github.com/skillhq/telegram"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheVilfer/better-tg-cli.git"
  },
  "bin": {
    "telegram": "dist/telegram.mjs"
  },
  "files": [
    "dist/telegram.mjs",
    "skills/better-tg-cli/*.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/gen-version.mjs && tsc --noEmit && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && bun scripts/bundle.mjs node",
    "prepublishOnly": "npm run build",
    "dev": "scripts/tg-dev",
    "dev:node": "TG_PROFILE=${TG_PROFILE-dev} TG_NO_UPDATE_CHECK=1 tsx src/index.ts",
    "dev:debug": "TG_PROFILE=${TG_PROFILE-dev} TG_NO_UPDATE_CHECK=1 tsx --inspect-brk src/index.ts",
    "dev:dist": "npm run build && TG_PROFILE=${TG_PROFILE-dev} TG_NO_UPDATE_CHECK=1 node dist/telegram.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "node scripts/gen-version.mjs",
    "typecheck": "tsc --noEmit",
    "coverage:api": "node scripts/api-coverage.mjs --check --min 90",
    "sdk:build": "bun packages/plugin-sdk/scripts/build.mjs",
    "template:check": "node scripts/plugin-template.mjs",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "lint": "oxlint && oxlint -c scripts/lint/fixtures.oxlintrc.json test/fixtures && node scripts/lint/no-comments-sh.mjs && oxfmt --check",
    "format": "oxfmt",
    "fix": "oxlint --fix && oxfmt"
  },
  "devDependencies": {
    "@jitl/quickjs-singlefile-mjs-release-sync": "0.32.0",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "big-integer": "^1.6.52",
    "commander": "^15.0.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "quickjs-emscripten-core": "0.32.0",
    "teleproto": "^1.229.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "8.3.1",
    "uqr": "^0.1.3",
    "vitest": "^5.1.1",
    "ws": "^8.22.1"
  },
  "engines": {
    "node": ">=20"
  },
  "mcpName": "io.github.TheVilfer/better-tg-cli"
}
