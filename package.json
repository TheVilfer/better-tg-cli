{
  "name": "better-telegram-cli",
  "version": "0.15.0",
  "description": "Agent-friendly Telegram CLI on your own account (MTProto, layer 229)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "telegram": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "telegram",
    "cli",
    "messaging",
    "chat"
  ],
  "author": "Sergei Polin (fork of skillhq/telegram by Derek Rein)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheVilfer/better-telegram-cli.git"
  },
  "homepage": "https://github.com/TheVilfer/better-telegram-cli#readme",
  "bugs": {
    "url": "https://github.com/TheVilfer/better-telegram-cli/issues"
  },
  "dependencies": {
    "big-integer": "^1.6.52",
    "chalk": "^5.3.0",
    "commander": "^14.0.0",
    "json5": "^2.2.3",
    "ora": "^8.1.0",
    "teleproto": "^1.229.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "LICENSE",
    "README.md",
    "SKILL.md",
    "dist",
    "reference.md"
  ],
  "private": true
}
