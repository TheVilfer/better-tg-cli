{
  // Cursor / VS Code: Run and Debug. Both CLI entries run src/ through tsx under Node
  // (breakpoints in .ts work; Bun can't be attached by the built-in debugger) with
  // TG_PROFILE=dev, so your real account and its Keychain entries are never touched.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CLI: telegram <args> (dev profile)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
      "program": "${workspaceFolder}/src/index.ts",
      "args": "${input:cliArgs}",
      "console": "integratedTerminal",
      "env": { "TG_PROFILE": "dev", "TG_NO_UPDATE_CHECK": "1" },
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "CLI: telegram <args> (dev profile, MTProto debug log)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
      "program": "${workspaceFolder}/src/index.ts",
      "args": "${input:cliArgs}",
      "console": "integratedTerminal",
      "env": { "TG_PROFILE": "dev", "TG_NO_UPDATE_CHECK": "1", "TG_LOG_LEVEL": "debug" },
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Tests: current file",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${relativeFile}"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Attach (npm run dev:debug)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "inputs": [
    { "id": "cliArgs", "type": "promptString", "description": "telegram arguments", "default": "check" }
  ]
}
