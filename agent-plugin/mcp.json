{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "telegram": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "better-tg-cli@0.39.5",
        "mcp"
      ],
      "cwd": "${PLUGIN_DATA}",
      "env": {
        "DBUS_SESSION_BUS_ADDRESS": "${DBUS_SESSION_BUS_ADDRESS}",
        "XDG_RUNTIME_DIR": "${XDG_RUNTIME_DIR}",
        "TG_PROFILE": "${TG_PROFILE}",
        "TG_READ_ONLY": "${TG_READ_ONLY}",
        "TG_LOG_LEVEL": "${TG_LOG_LEVEL}",
        "TG_FLOOD_WAIT_MAX": "${TG_FLOOD_WAIT_MAX}",
        "TG_TRANSPORT": "${TG_TRANSPORT}",
        "TG_NO_UPDATE_CHECK": "${TG_NO_UPDATE_CHECK}"
      }
    }
  }
}
